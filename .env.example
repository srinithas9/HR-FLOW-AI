# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hr_operations_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hr_operations_db

# Application Configuration
APP_NAME=AI-Powered HR Operations & Action Intelligence Platform
APP_ENV=development
APP_PORT=8000
DEBUG=True
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Kolkata

# Security & JWT (Replace with strong random secret in production)
JWT_SECRET_KEY=change_me_to_a_secure_random_secret_in_production_min_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_USER_PASSWORD=Password@123

# CORS (Comma-separated or JSON list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

